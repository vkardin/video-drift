{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Video Drift",
  "description": "__MSG_extDescription__",
  "version": "2.0.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Video Drift",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/store.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "speed-up": {
      "suggested_key": { "default": "Alt+Shift+Period" },
      "description": "__MSG_cmdSpeedUp__"
    },
    "speed-down": {
      "suggested_key": { "default": "Alt+Shift+Comma" },
      "description": "__MSG_cmdSpeedDown__"
    },
    "add-bookmark": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "__MSG_cmdBookmark__"
    }
  }
}
